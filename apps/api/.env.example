# bcontext-api environment: every variable the API, the pg-boss worker and
# the error collector read (one image, BCONTEXT_PROCESS picks the process).
# With the root docker-compose.yml most of these are set for you from the
# root .env (see ../../.env.example); this list is the full reference.
# Everything here is read at call time unless noted; nothing has a default
# that points at somebody else's instance.
#
# Legacy spellings still read as fallbacks until 2026-12-31 (src/lib/env.ts):
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, NEXT_PUBLIC_APP_URL,
# NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_ALLOWED_ORIGINS. Set the plain names.

# =============================================================================
# REQUIRED
# =============================================================================

# Supabase gateway (Kong) URL; without it and the service key the API runs on the in-memory demo store.
SUPABASE_URL=
# The same gateway as browsers reach it, when it differs (docker compose: http://kong:8000 internally, your domain publicly). Storage URLs and the session cookie name use it. Unset = SUPABASE_URL.
# SUPABASE_PUBLIC_URL=
# Supabase anon JWT, used to validate user sessions.
SUPABASE_ANON_KEY=
# Supabase service-role JWT, for server-side reads and writes.
SUPABASE_SERVICE_ROLE_KEY=
# Direct, session-mode Postgres URL (never a transaction pooler): worker queues, realtime LISTEN/NOTIFY, transactional webhooks.
DATABASE_URL=
# Public URL of the web app: invitation and email links, OAuth redirects, discovery documents. API and worker refuse to boot without it in production.
APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL — process, database and queue
# =============================================================================

# Which process the image starts: api (default), worker or errors.
# BCONTEXT_PROCESS=api
# Port the API listens on (default 4000).
# API_PORT=4000
# Postgres TLS: unset = plain TCP on loopback, TLS elsewhere; `require` forces TLS, `disable` turns it off.
# DATABASE_SSL=
# Max connections in the API/worker Postgres pool (default 5).
# DATABASE_POOL_MAX=5
# application_name the pool reports to Postgres (default bcontext-worker).
# DATABASE_APP_NAME=bcontext-worker
# Max connections pg-boss opens (default 3).
# PGBOSS_POOL_MAX=3
# Schema pg-boss keeps its tables in (default pgboss).
# PGBOSS_SCHEMA=pgboss
# Days a done, untouched task waits before the worker archives it (default 30).
# TASKS_AUTO_ARCHIVE_DAYS=30
# Internal URL of the API, only for a process WITHOUT DATABASE_URL to relay realtime events (e.g. http://api:4000).
API_ORIGIN=
# Shared secret of POST /realtime/broadcast, the same no-DATABASE_URL fallback.
REALTIME_SECRET=
# Extra browser origins (comma-separated) the API accepts writes from, besides APP_URL.
# ALLOWED_ORIGINS=

# =============================================================================
# OPTIONAL — access and email
# =============================================================================

# Comma-separated emails allowed into /admin. Unset = nobody is an admin.
ADMIN_EMAILS=
# Who may sign up and create organizations: `open` (default, anyone signed in; self-service signup on) or `admin` (only ADMIN_EMAILS, who invite the owners).
# ORG_CREATION=open
# Resend API key; without it (or without EMAIL_FROM) invitations are copyable links and no email is sent.
RESEND_API_KEY=
# Sender of every email, RFC 5322 ("Acme Context <no-reply@acme.com>"); must be verified in Resend. No default.
EMAIL_FROM=
# How the instance names itself in email footers (default Bcontext).
# INSTANCE_NAME=Bcontext

# =============================================================================
# OPTIONAL — AI (src/lib/ai/provider.ts). Without a backend: keyword search,
# retrieval-only answers, no extraction or embeddings.
# =============================================================================

# Backend A: Vercel AI Gateway key; model ids are "provider/model". The only backend with rerank.
AI_GATEWAY_API_KEY=
# Backend B: any OpenAI-compatible server (Ollama http://localhost:11434/v1, LiteLLM, vLLM). Wins over the gateway when set.
# OPENAI_BASE_URL=
# Key for OPENAI_BASE_URL, when the server wants one.
# OPENAI_API_KEY=
# Interactive answers: Nexo chat, ask_nexo/ask_rag, skills, autofix, meeting refine. Use the backend's own model names.
CHAT_MODEL=anthropic/claude-sonnet-5
# Structured extraction and judging (ingest, conflicts, contradiction sweep, integrations).
EXTRACT_MODEL=deepseek/deepseek-v4-flash
# Gateway hosts allowed to serve open-weight extract models (comma-separated; gateway only).
# EXTRACT_PROVIDERS=azure,deepinfra,fireworks
# Embeddings; must return 1536-dimensional vectors (the pgvector columns are vector(1536)).
EMBEDDING_MODEL=openai/text-embedding-3-small
# `1` turns on Contextual Retrieval prefixes per chunk (off: measured not to help, ~90% of AI spend).
# CONTEXTUAL_RETRIEVAL=1
# Model for those prefixes, only with CONTEXTUAL_RETRIEVAL=1.
# CONTEXT_MODEL=anthropic/claude-haiku-4-5
# Rerank model on the gateway (default cohere/rerank-v3.5); ignored with OPENAI_BASE_URL.
# RERANK_MODEL=cohere/rerank-v3.5
# Measurement only: `1` forces keyword retrieval even with embeddings. Never in production.
# RAG_FORCE_KEYWORD=
# Triage confidence at or above which candidates are written without review (default 0.7).
NEXO_AUTO_ACCEPT_THRESHOLD=0.7
# Contradiction-judge model calls per workspace per day; 0 disables judging (default 50).
# NEXO_CONTRADICTIONS_MAX_PAIRS=50

# =============================================================================
# OPTIONAL — integrations. Unset connectors answer 503/404; the rest runs.
# Webhook and callback URLs are <APP_URL>/api/webhooks/<x> and
# <APP_URL>/api/connectors/<x>/callback (docs/integrations-nango.md).
# =============================================================================

# GitHub App id (permissions: Contents rw, Issues r, Pull requests r).
GITHUB_APP_ID=
# GitHub App slug, for the install link.
GITHUB_APP_SLUG=
# GitHub App private key (PEM).
GITHUB_APP_PRIVATE_KEY=
# GitHub webhook secret.
GITHUB_WEBHOOK_SECRET=
# Slack app OAuth client id.
SLACK_CLIENT_ID=
# Slack app OAuth client secret.
SLACK_CLIENT_SECRET=
# Slack request signing secret.
SLACK_SIGNING_SECRET=
# Linear OAuth client id.
LINEAR_CLIENT_ID=
# Linear OAuth client secret.
LINEAR_CLIENT_SECRET=
# Linear webhook signing secret.
LINEAR_WEBHOOK_SECRET=
# Notion OAuth client id (one-shot importer).
NOTION_CLIENT_ID=
# Notion OAuth client secret.
NOTION_CLIENT_SECRET=
# Meeting bot provider (default recall).
# MEETING_BOT_PROVIDER=recall
# Recall.ai API key.
RECALL_API_KEY=
# Recall.ai webhook secret.
RECALL_WEBHOOK_SECRET=
# Recall.ai API base, only for a non-default region.
RECALL_API_BASE=
# Recall transcript provider (default recallai_streaming).
# RECALL_TRANSCRIPT_PROVIDER=recallai_streaming
# Your Nango server as the API reaches it (self-hosted). No default: without it the long-tail integrations are off.
NANGO_SERVER_URL=
# Nango environment secret key.
NANGO_SECRET_KEY=
# Nango webhook signing key.
NANGO_WEBHOOK_SECRET=
# Nango URL the browser reaches, when different from NANGO_SERVER_URL; also the OAuth callback host.
NANGO_PUBLIC_URL=

# =============================================================================
# OPTIONAL — telemetry
# =============================================================================

# Error collector address every process reports to (e.g. http://errors:4100); no-op unless the key is set too.
ERRORS_INGEST_URL=
# Shared secret between reporters and the collector (`openssl rand -hex 32`); the errors process refuses to boot without it.
ERRORS_INGEST_KEY=
# Port the errors process listens on (default 4100).
ERRORS_PORT=4100
# Postgres connections of the errors process (default 4).
ERRORS_POOL_MAX=4
# Error events kept per group per minute (default 5); counters stay exact.
ERRORS_SAMPLE_CAP=5
# Worker deletes error events older than this many days (default 30).
ERRORS_EVENT_RETENTION_DAYS=30
# Worker deletes quiet, empty, un-noted error groups after this many days (default 90).
ERRORS_GROUP_RETENTION_DAYS=90
# Build a report belongs to; falls back to SOURCE_COMMIT, then GIT_COMMIT_SHA.
RELEASE_SHA=
# Commit of the build (the SOURCE_COMMIT build arg); shown by /api/health.
# SOURCE_COMMIT=
# Better Stack source token: ships warn/error logs when set with the URL below.
BETTER_STACK_SOURCE_TOKEN=
# Better Stack ingesting host URL.
BETTER_STACK_INGESTING_URL=
# Lowest level shipped to Better Stack (default warn).
BETTER_STACK_MIN_LEVEL=
