{
  "name": "bcontext-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs",
    "worker": "node dist/worker.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "rag:eval": "node scripts/rag-eval.mjs",
    "db:reset": "bash scripts/db-reset.sh",
    "gen:api-routes": "node scripts/gen-api-routes.mjs",
    "nango:sync": "npx tsx scripts/nango-sync-integrations.ts",
    "build:api": "node scripts/build-api.mjs",
    "start:api": "node dist/api.cjs",
    "build:errors": "node scripts/build-errors.mjs",
    "start:errors": "node dist/errors.cjs",
    "verify": "sh scripts/verify.sh",
    "build:contract": "npm run -s build --prefix ../../packages/contract",
    "pretest": "npm run -s build:contract",
    "pretypecheck": "npm run -s build:contract",
    "build": "npm run -s build:contract && npm run -s build:api && npm run -s build:worker && npm run -s build:errors"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.82",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "ai": "^6.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.5",
    "jszip": "^3.10.1",
    "nanoid": "^5.0.7",
    "pg": "^8.23.0",
    "pg-boss": "^12.29.0",
    "resend": "^6.12.3",
    "tldts": "^7.4.9",
    "ws": "^8.21.3",
    "zod": "^3.23.8",
    "@bcontext-dev/contract": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  },
  "license": "AGPL-3.0-only"
}
