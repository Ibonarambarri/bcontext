# bcontext-web environment. With the root docker-compose.yml these are set for
# you; this list is for running the web app on its own (`npm run dev`).
#
# Read at RUNTIME (src/lib/public-env.ts, served to the browser as /env.js):
# one build serves any domain. The NEXT_PUBLIC_* spellings are still read as
# a build-time fallback, which is what `next dev` with this file uses.

# Supabase Auth — the only Supabase the web app talks to (sessions, sign-in).
# Data goes through the API.
#   SUPABASE_URL         the gateway as this server reaches it
#   SUPABASE_PUBLIC_URL  the gateway as browsers reach it (unset = SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLIC_URL=
# SUPABASE_ANON_KEY=

# The API process. API_ORIGIN is read at BUILD time by next.config.mjs (the
# proxy rewrites for /api/*, /mcp, …) and at runtime for server-side calls.
# Required: this app has no API code of its own.
API_ORIGIN=http://localhost:4000
# The API origin as a WebSocket URL, for presence and collaboration. Unset =
# same-browser BroadcastChannel fallback. Runtime name: REALTIME_PUBLIC_URL.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000

# Optional: the public origin of this web app (links in emails, robots.txt,
# MCP endpoints in the docs). Unset = the origin of each request.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Better Stack error/log telemetry.
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_INGESTING_URL=
BETTER_STACK_MIN_LEVEL=

# Optional: the error collector (the API image with BCONTEXT_PROCESS=errors,
# shown in /admin/errors). Server-side only — the key never reaches the
# browser: the page posts to /api/client-errors and this process forwards.
# Both unset = the whole pipeline is a no-op.
ERRORS_INGEST_URL=
ERRORS_INGEST_KEY=

# Optional: self-hosted Nango (auth + proxy for long-tail integrations): its
# API and its Connect UI as the browser reaches them. Unset = Nango-backed
# integrations cannot be connected from the web. Runtime names:
# NANGO_PUBLIC_HOST and NANGO_CONNECT_URL.
NEXT_PUBLIC_NANGO_HOST=
NEXT_PUBLIC_NANGO_CONNECT_URL=
