# Bcontext instance configuration, read by docker compose.
# ./setup.sh copies this to .env and fills in every secret; you should not
# need to edit the REQUIRED block by hand. Everything the API reads is
# documented in apps/api/.env.example.

# =============================================================================
# REQUIRED (setup.sh fills these)
# =============================================================================

# Public hostname. `localhost` for a local try-out.
BCONTEXT_DOMAIN=localhost
# What Caddy serves: the bare domain for automatic HTTPS, or http://localhost.
BCONTEXT_SITE_ADDRESS=http://localhost
# The origin people open in the browser (no trailing slash).
PUBLIC_URL=http://localhost
# The same origin as a WebSocket URL (ws:// or wss://), for realtime presence.
REALTIME_PUBLIC_URL=ws://localhost

# Postgres password (also used by the Supabase service roles). Hex only:
# it is embedded in connection URLs.
POSTGRES_PASSWORD=
# Signs every Supabase JWT (sessions, the anon and service-role keys below).
JWT_SECRET=
# HS256 JWTs signed with JWT_SECRET: role=anon and role=service_role.
ANON_KEY=
SERVICE_ROLE_KEY=
# Shared secret of POST /realtime/broadcast between processes.
REALTIME_SECRET=
# Shared secret between the processes and the error collector (profile errors).
ERRORS_INGEST_KEY=
# Studio's key for postgres-meta (profile studio).
PG_META_CRYPTO_KEY=

# Comma-separated emails that may open /admin.
ADMIN_EMAILS=
# `open`: anyone may sign up and create an organization. `admin`: only
# ADMIN_EMAILS create organizations and invite their owners.
ORG_CREATION=open

# =============================================================================
# EMAIL (optional). Without it accounts are confirmed on creation, invitations
# are copyable links and password reset emails are not sent.
# =============================================================================

# Resend (https://resend.com) for the product's own emails.
# RESEND_API_KEY=
# EMAIL_FROM=Bcontext <no-reply@example.com>
# How the instance names itself in emails (default Bcontext).
# INSTANCE_NAME=Bcontext

# Auth's own emails (confirmation, password reset) go over SMTP. setup.sh
# points this at Resend's SMTP when you give it a Resend key.
ENABLE_EMAIL_AUTOCONFIRM=true
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=no-reply@example.com
# SMTP_SENDER_NAME=Bcontext

# =============================================================================
# AI (optional). Without a backend: keyword search, retrieval-only answers,
# no extraction or embeddings.
# =============================================================================

# Backend A: Vercel AI Gateway key; model ids are "provider/model".
# AI_GATEWAY_API_KEY=
# Backend B: any OpenAI-compatible server (Ollama, LiteLLM, vLLM). Wins when set.
# From inside Docker, a server on the host is http://host.docker.internal:11434/v1.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# Model names in the backend's own naming. Embeddings must be 1536-dimensional.
# CHAT_MODEL=anthropic/claude-sonnet-5
# EXTRACT_MODEL=deepseek/deepseek-v4-flash
# EMBEDDING_MODEL=openai/text-embedding-3-small

# =============================================================================
# OPTIONAL — operations
# =============================================================================

# Image tag of ghcr.io/ibonarambarri/bcontext-{api,web} (default latest).
# BCONTEXT_VERSION=latest
# `missing` (default) pulls the images once; `build` always builds locally.
# BCONTEXT_PULL_POLICY=missing
# Published ports of Caddy.
# HTTP_PORT=80
# HTTPS_PORT=443
# Supabase Studio on 127.0.0.1 (docker compose --profile studio up -d).
# STUDIO_PORT=54323
# Error collector (docker compose --profile errors up -d), then:
# ERRORS_INGEST_URL=http://errors:4100
# Session lifetime in seconds.
# JWT_EXPIRY=3600
# `false` re-opens GoTrue's own /auth/v1/signup (default true: accounts are
# created only through the API, which enforces ORG_CREATION).
# DISABLE_SIGNUP=true

# Self-hosted Nango for long-tail integrations (apps/api/docs/integrations-nango.md):
# NANGO_SERVER_URL=          as the API reaches it
# NANGO_SECRET_KEY=
# NANGO_WEBHOOK_SECRET=
# NANGO_PUBLIC_URL=          as the browser reaches it
# NANGO_CONNECT_URL=         Nango's Connect UI origin

# Integrations (GitHub App, Slack, Linear, Notion, Recall, Nango): see
# apps/api/.env.example; add the variables here and `docker compose up -d`.
